---
interface Props {
  index?: string; // e.g. "01"
  label: string; // mono eyebrow, e.g. "SELECTED EXPERIMENT"
  title?: string; // optional serif heading below
}
const { index, label, title } = Astro.props;
---

<div class="section-head">
  {index && <span class="mono index">{index}</span>}
  <span class="mono">{label}</span>
</div>
{title && <h2 class="sh-title">{title}</h2>}

<style>
  .sh-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    max-width: 18ch;
    margin-bottom: 1.25rem;
  }
</style>
