---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: string; // "01"
}
const { project, index } = Astro.props;
const { data } = project;
const href = `/work/${project.slug}`;
---

<article class="row">
  <div class="meta">
    <span class="mono index">{index}</span>
    <span class="mono">{data.status}</span>
  </div>
  <div class="body">
    <h3 class="q"><a class="plain" href={href}>{data.question}</a></h3>
    <p class="summary">{data.summary}</p>
    <p class="result"><span class="mono">RESULT</span> {data.cardResult}</p>
    <div class="actions">
      <a class="cta cta--accent" href={href}>Read the experiment ↗</a>
      <a class="cta" href={data.repoUrl} rel="noopener" target="_blank">View code ↗</a>
    </div>
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(6rem, 9rem) 1fr;
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .q {
    font-size: clamp(1.4rem, 3.2vw, 1.9rem);
    line-height: 1.15;
    max-width: 22ch;
  }
  .plain:hover {
    color: var(--oxide);
  }
  .summary {
    margin-top: 0.9rem;
    color: var(--ink-muted);
    max-width: 58ch;
  }
  .result {
    margin-top: 0.9rem;
    max-width: 58ch;
    line-height: 1.5;
  }
  .result .mono {
    color: var(--oxide);
    margin-right: 0.5rem;
  }
  .actions {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }
  @media (max-width: 600px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .meta {
      flex-direction: row;
      gap: 1rem;
    }
  }
</style>
