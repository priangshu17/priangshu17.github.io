---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT, NOW } from '../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects[0];
const second = projects[1];

const questions = ['What fits in memory?', 'What gets faster?', 'What quality do we lose?'];

const howIWork = [
  { verb: 'Question', note: 'Ask something precise enough that a measurement can answer it.' },
  { verb: 'Implement', note: 'Build the baseline and the variants under one controlled pipeline.' },
  { verb: 'Measure', note: 'Instrument time, memory and quality — then report the numbers.' },
  { verb: 'Explain', note: 'Separate what was observed from the trade-off that explains it.' },
];
---

<BaseLayout path="/">
  {/* ---------- Hero ---------- */}
  <section class="wrap hero">
    <p class="eyebrow">{SITE.tagline}</p>
    <h1>ML engineering,<br />under real constraints.</h1>
    <p class="lede measure">
      I build experiments around fine-tuning, attention and inference, then
      document what the measurements show.
    </p>
    <div class="hero-actions">
      <a class="cta cta--accent" href="/work">Explore the experiments ↘</a>
      <a class="cta" href={CONTACT.github} rel="noopener" target="_blank">GitHub ↗</a>
    </div>
    <ul class="questions" aria-label="The questions behind the work">
      {questions.map((q) => <li class="mono">{q}</li>)}
    </ul>
  </section>

  {/* ---------- Featured experiment (dark technical panel) ---------- */}
  {
    featured && (
      <section class="panel featured">
        <div class="wrap grid">
          <div class="text">
            <div class="section-head">
              <span class="mono index">01</span>
              <span class="mono">Selected experiment</span>
            </div>
            <h2>{featured.data.shortTitle}.</h2>
            <p class="config mono">FP16 LoRA vs NF4 QLoRA — time, memory and perplexity.</p>
            <p class="lead">{featured.data.resultsLead}</p>
            <div class="actions">
              <a class="cta" href={`/work/${featured.slug}`}>Read the experiment ↗</a>
              <a class="cta" href={featured.data.repoUrl} rel="noopener" target="_blank">
                View code ↗
              </a>
            </div>
          </div>
          <figure class="panel-fig">
            <img
              src={featured.data.figures[0].src}
              alt={featured.data.figures[0].alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="mono index">{featured.data.figures[0].figNo}</span>
              <span>{featured.data.figures[0].caption}</span>
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }

  {/* ---------- Second experiment (light) ---------- */}
  {
    second && (
      <section class="wrap section second">
        <div class="grid">
          <figure class="light-fig">
            <img
              src={second.data.figures[0].src}
              alt={second.data.figures[0].alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="mono index">{second.data.figures[0].figNo}</span>
              <span>{second.data.figures[0].caption}</span>
            </figcaption>
          </figure>
          <div class="text">
            <div class="section-head">
              <span class="mono index">02</span>
              <span class="mono">{second.data.shortTitle}</span>
            </div>
            <h2>{second.data.title}</h2>
            <p class="config mono">Naive · SDPA · FlashAttention</p>
            <p class="lead">{second.data.resultsLead}</p>
            <div class="actions">
              <a class="cta cta--accent" href={`/work/${second.slug}`}>Read the experiment ↗</a>
              <a class="cta" href={second.data.repoUrl} rel="noopener" target="_blank">
                View code ↗
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* ---------- How I work ---------- */}
  <section class="wrap section">
    <div class="section-head">
      <span class="mono index">03</span>
      <span class="mono">How I work</span>
    </div>
    <ul class="how">
      {
        howIWork.map((h, i) => (
          <li>
            <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{h.verb}</h3>
            <p>{h.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------- Now (current role) ---------- */}
  <section class="wrap section now">
    <div class="section-head">
      <span class="mono index">04</span>
      <span class="mono">Now</span>
    </div>
    <div class="now-grid">
      <div class="role">
        <h2>
          {NOW.role},{' '}
          {
            NOW.companyUrl ? (
              <a class="link" href={NOW.companyUrl} rel="noopener" target="_blank">{NOW.company}</a>
            ) : (
              NOW.company
            )
          }
        </h2>
        <p class="role-meta mono">{NOW.period} · {NOW.location}</p>
        <p class="role-lede">{NOW.lede}</p>
      </div>
      <ul class="now-items">
        {
          NOW.items.map((it) => (
            <li>
              <div class="item-head">
                <span class="mono index">{it.label}</span>
                {it.status && <span class="mono status">{it.status}</span>}
              </div>
              <p>{it.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------- About & contact ---------- */}
  <section class="wrap section about-teaser">
    <div class="section-head">
      <span class="mono index">05</span>
      <span class="mono">About</span>
    </div>
    <div class="grid-about">
      <p class="about-body">
        I&rsquo;m an ML engineer drawn to the systems side of machine learning —
        the trade-offs behind efficient language models. Most of my work starts
        from a hardware constraint and asks what it costs: what fits in memory,
        what runs faster, and what quality you give up to get there.
      </p>
      <div class="about-links">
        <a class="cta" href="/about">Read more ↗</a>
        <a class="cta" href={CONTACT.github} rel="noopener" target="_blank">GitHub ↗</a>
        {CONTACT.linkedin && (
          <a class="cta" href={CONTACT.linkedin} rel="noopener" target="_blank">LinkedIn ↗</a>
        )}
        {CONTACT.email && <a class="cta" href={`mailto:${CONTACT.email}`}>Email ↗</a>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .hero h1 {
    font-size: clamp(2.8rem, 9vw, 5.2rem);
    line-height: 1.02;
    margin-top: 1.25rem;
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: 1.5rem;
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }
  .questions {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding: 1.5rem 0 0;
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--rule);
  }
  .questions li::before {
    content: '↘ ';
    color: var(--oxide);
  }

  /* Shared two-column grids */
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .text h2 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    line-height: 1.08;
    max-width: 16ch;
  }
  .config {
    margin-top: 0.9rem;
  }
  .lead {
    margin-top: 1.1rem;
    max-width: 46ch;
    line-height: 1.55;
  }
  .actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }

  /* Featured dark panel */
  .featured {
    margin-block: var(--section-gap);
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .featured .lead {
    color: var(--panel-muted);
  }
  .panel-fig,
  .light-fig {
    margin: 0;
  }
  .panel-fig img,
  .light-fig img {
    width: 100%;
    background: #fff;
    padding: 12px;
    border: 1px solid var(--rule);
  }
  .panel-fig figcaption,
  .light-fig figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .panel-fig figcaption {
    border-top: 1px solid var(--panel-rule);
    color: var(--panel-muted);
  }
  .light-fig figcaption {
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
  }

  /* How I work */
  .how {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .how li {
    background: var(--paper);
    padding: 1.5rem 1.25rem 1.75rem;
  }
  .how .num {
    color: var(--oxide);
  }
  .how h3 {
    font-size: 1.35rem;
    margin-top: 0.6rem;
  }
  .how p {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* Now (current role) */
  .now-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) 1.6fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .role h2 {
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    line-height: 1.12;
    max-width: 16ch;
  }
  .role-meta {
    margin-top: 0.9rem;
  }
  .role-lede {
    margin-top: 1rem;
    color: var(--ink-muted);
    max-width: 34ch;
    line-height: 1.55;
  }
  .now-items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .now-items li {
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }
  .item-head .status {
    color: var(--oxide);
  }
  .now-items p {
    line-height: 1.55;
    max-width: 62ch;
  }

  /* About teaser */
  .grid-about {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .about-body {
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 52ch;
  }
  .about-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  @media (max-width: 760px) {
    .grid,
    .grid-about,
    .now-grid {
      grid-template-columns: 1fr;
    }
    /* Keep the reading order sensible: text before figure on the second block */
    .second .light-fig {
      order: 2;
    }
    .how {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 420px) {
    .how {
      grid-template-columns: 1fr;
    }
  }
</style>
