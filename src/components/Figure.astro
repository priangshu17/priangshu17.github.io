---
interface Props {
  figNo: string;
  src: string;
  alt: string;
  caption: string;
}
const { figNo, src, alt, caption } = Astro.props;
---

<figure class="fig">
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  <figcaption>
    <span class="mono index">{figNo}</span>
    <span class="cap">{caption}</span>
  </figcaption>
</figure>

<style>
  .fig {
    margin: 0;
  }
  .fig img {
    width: 100%;
    background: #fff;
    border: 1px solid var(--rule);
    padding: 12px;
  }
  figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }
  .cap {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  figcaption .index {
    padding-top: 0.1rem;
  }
</style>
